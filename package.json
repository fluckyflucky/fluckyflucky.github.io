{
  "name": "aoinatsu",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test:civilization": "node scripts/test-civilization.mjs && node scripts/test-civilization-fidelity.mjs && node scripts/test-civilization-rules.mjs",
