[{"k":["乃公","迺公"],"r":["だいこう","おれ"],"o":["daikou","ore"],"s":[{"p":["pronoun"],"e":["I","me"],"z":["我；本人"]}],"x":[]},{"k":[],"r":["オーレ","オレ"],"o":["oore","ore"],"s":[{"p":["interjection (kandoushi)"],"e":["olé"],"z":["哦蕾"]}],"x":[{"j":"誰もオレを止められない。","c":"没人能阻止我！"},{"j":"仕事の邪魔立てされては黙っておれない。","c":"我无法容忍别人打扰我的工作。"},{"j":"お前は、オレには絶対勝てないだろう。","c":"你是绝对赢不了我的。"}]},{"k":["俺","己"],"r":["おれ","オレ","おらあ","おり"],"o":["ore","ore","oraa","ori"],"s":[{"p":["pronoun"],"e":["I","me"],"z":["我"]}],"x":[{"j":"みんな、俺も全力でフォローする。このイベントかならず成功させるぞ。","c":"大伙儿，我会全力跟进的。一定会把这事办成的。"},{"j":"こいつ、さっきまで俺の相棒だったのに、もう寝返りやがった。","c":"这家伙刚刚还是我这边儿的人，现在已经叛变了。"},{"j":"不言実行が俺のやり方。","c":"我的做法是要行动不要空话。"}]},{"k":["爾","儞"],"r":["おれ"],"o":["ore"],"s":[{"p":["pronoun"],"e":["you"],"z":["你"]}],"x":[]},{"k":["折れ"],"r":["おれ"],"o":["ore"],"s":[{"p":["noun (common) (futsuumeishi)"],"e":["fold","bend","broken part"],"z":["折痕"]}],"x":[{"j":"僕は右に折れた。","c":"我往右拐了。"}]}]