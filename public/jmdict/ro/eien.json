[{"k":["永遠"],"r":["えいえん"],"o":["eien"],"s":[{"p":["noun (common) (futsuumeishi)","nouns which may take the genitive case particle 'no'","adjectival nouns or quasi-adjectives (keiyodoshi)"],"e":["eternity","perpetuity","permanence","immortality"],"z":["永恒；永久；永远；不朽"]}],"x":[{"j":"この儘では誰もが、永遠の滅びを免れないことになります。","c":"照这样下去，任何人都无法逃脱永恒的灭亡。"},{"j":"犠牲を楽しみと見なせることは、他人を思いやり思いやることのできる人で、永遠に楽しく、有意義に生きられる。","c":"把牺牲当做享受，能够付出爱心的人，永远都很快乐，而且活得有意义。"},{"j":"そしてすべての書名を公に示し、永遠に販売を禁止した。","c":"然后又把各书名揭示通衢，永远禁止贩卖。"}]},{"k":["永延"],"r":["えいえん"],"o":["eien"],"s":[{"p":["noun (common) (futsuumeishi)"],"e":["Eien era (987.4.5-989.8.8)"],"z":["永延年号（987-989年）"]}],"x":[]},{"k":["永遠の生命"],"r":["えいえんのせいめい"],"o":["eiennoseimei"],"s":[{"p":["expressions (phrases, clauses, etc.)"],"e":["eternal life"],"z":["永恒的生命"]}],"x":[]},{"k":["永遠回帰"],"r":["えいえんかいき"],"o":["eienkaiki"],"s":[{"p":["noun (common) (futsuumeishi)"],"e":["eternal return","eternal recurrence"],"z":["永恒轮回"]}],"x":[]},{"k":["永遠の眠り"],"r":["えいえんのねむり"],"o":["eiennonemuri"],"s":[{"p":["expressions (phrases, clauses, etc.)","noun (common) (futsuumeishi)"],"e":["eternal slumber","everlasting rest","death"],"z":["永恒的睡眠；永远的安息；死亡"]}],"x":[]},{"k":["永遠の旅人"],"r":["えいえんのたびびと"],"o":["eiennotabibito"],"s":[{"p":["expressions (phrases, clauses, etc.)","noun (common) (futsuumeishi)"],"e":["perpetual traveller (traveler)","permanent traveller","permanent tourist"],"z":["永久旅行者"]}],"x":[]},{"k":["永遠平和のために"],"r":["えいえんへいわのために"],"o":["eienheiwanotameni"],"s":[{"p":["noun (common) (futsuumeishi)"],"e":["Perpetual Peace (by Immanuel Kant)"],"z":["永恒和平（伊曼努尔·康德著）"]}],"x":[]}]