[{"k":["言うまでもない","言うまでも無い","言う迄も無い","言う迄もない"],"r":["いうまでもない","ゆうまでもない"],"o":["iumademonai","yuumademonai"],"s":[{"p":["expressions (phrases, clauses, etc.)","adjective (keiyoushi)"],"e":["goes without saying","needless to say","obvious"],"z":["不言而喻；不必说；显而易见"]}],"x":[{"j":"彼が無罪であることは言うまでもない。","c":"不用说，他是无辜的。"},{"j":"私達は彼の勇気は言うまでもなく、彼の知恵にも感嘆した。","c":"我们很钦佩他的智慧，更别说他的勇气了。"},{"j":"言うまでもないことだが、健康の方が富より大事だ。","c":"不用说，健康比财富重要。"}]},{"k":["言うまでもなく","言うまでも無く","言う迄もなく","言う迄も無く"],"r":["いうまでもなく","ゆうまでもなく"],"o":["iumademonaku","yuumademonaku"],"s":[{"p":["expressions (phrases, clauses, etc.)"],"e":["obviously","as we all know","needless to say","of course","it goes without saying"],"z":["显然；众所周知；不用说；当然；不言而喻"]}],"x":[{"j":"私達は彼の勇気は言うまでもなく、彼の知恵にも感嘆した。","c":"我们很钦佩他的智慧，更别说他的勇气了。"}]},{"k":["言うも愚か","言うもおろか"],"r":["いうもおろか"],"o":["iumooroka"],"s":[{"p":["expressions (phrases, clauses, etc.)"],"e":["to go without saying"],"z":["不言而喻；显而易见"]}],"x":[]}]