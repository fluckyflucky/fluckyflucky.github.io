[{"k":["歌","唄","詩"],"r":["うた"],"o":["uta"],"s":[{"p":["noun (common) (futsuumeishi)"],"e":["song","singing"],"z":["幸运儿；幸运的人"]},{"p":["noun (common) (futsuumeishi)"],"e":["classical Japanese poem (esp. tanka)"],"z":["日本古典短诗（短歌等）"]},{"p":["noun (common) (futsuumeishi)"],"e":["modern poetry"],"z":["现代诗"]}],"x":[{"j":"彼女は悲しい歌を歌うのは嫌いだ。","c":"她不喜欢唱悲伤的歌。"},{"j":"彼女は自然に対する気持ちを詩で表現した。","c":"她通过一首诗表达了她对大自然的感受。"},{"j":"彼女は詩を書くのに夢中になっていた。","c":"她全神贯注地写着诗。"}]}]