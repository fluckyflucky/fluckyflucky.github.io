[{"k":["叔父","伯父"],"r":["おじ","はくふ","しゅくふ"],"o":["oji","hakufu","shukufu"],"s":[{"p":["noun (common) (futsuumeishi)"],"e":["uncle"],"z":["叔叔"]}],"x":[{"j":"僕たちは叔父の家に泊まっています。","c":"我们待在舅舅家。"},{"j":"彼は叔父のところに泊まっている。","c":"他在他舅舅那里过夜。"},{"j":"先月、僕の叔父の会社が新製品を発売しました。","c":"舅舅的公司上个月推出了一款新产品。"}]},{"k":["祖父"],"r":["そふ","じじ","じい","おおじ","おじ","そぶ"],"o":["sofu","jiji","jii","ooji","oji","sobu"],"s":[{"p":["noun (common) (futsuumeishi)"],"e":["grandfather"],"z":["祖父；老人｜老人面具"]},{"p":["noun (common) (futsuumeishi)"],"e":["old man"],"z":["老翁"]},{"p":["noun (common) (futsuumeishi)"],"e":["kyogen mask used for the role of an old man"],"z":["狂言老翁面具"]}],"x":[{"j":"彼は駅へ祖父を見送りに言った。","c":"他去车站送爷爷了。"},{"j":"彼の名は祖父にちなんでつけられた。","c":"他以他祖父的名字被命名。"},{"j":"祖父は非常に健康だ。","c":"我的祖父非常健康。"}]},{"k":["老翁"],"r":["ろうおう","おじ"],"o":["rouou","oji"],"s":[{"p":["noun (common) (futsuumeishi)"],"e":["old man"],"z":["老翁；老人"]}],"x":[]},{"k":["小父"],"r":["おじ"],"o":["oji"],"s":[{"p":["noun (common) (futsuumeishi)"],"e":["old man","mister"],"z":["老人；先生"]}],"x":[]}]