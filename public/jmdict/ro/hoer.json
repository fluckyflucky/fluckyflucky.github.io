[{"k":["吠える","吼える","咆える"],"r":["ほえる"],"o":["hoeru"],"s":[{"p":["Ichidan verb","intransitive verb"],"e":["to bark","to howl","to bay","to roar","to yelp","to yap"],"z":["吠叫；嚎叫；咆哮"]},{"p":["Ichidan verb","intransitive verb"],"e":["to howl (of the wind)","to roar (of the sea)"],"z":["呼啸；咆哮"]},{"p":["Ichidan verb","intransitive verb"],"e":["to yell","to shout","to cry","to moan"],"z":["叫喊；呐喊"]}],"x":[{"j":"遠いところで犬が吠えているのが聞こえた。","c":"我从远处听到狗吠声。"},{"j":"近くで犬が吠えている。","c":"附近有狗在叫。"},{"j":"吼えるな！","c":"别汪汪！"}]}]