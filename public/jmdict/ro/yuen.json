[{"k":["故に"],"r":["ゆえに"],"o":["yueni"],"s":[{"p":["conjunction"],"e":["therefore","consequently"],"z":["因此"]}],"x":[{"j":"結婚の利益は、女性の本質を知ることであり、結婚の損失は、女性への幻滅を知ることである。それ故に結婚しない小説家は、未だ女を書くことが出来ない。結婚した詩人は、もはや女を歌うことができない。","c":"婚姻的优点在于你会明白女性的本性，而缺点在于你对女性的幻想会被磨灭。所以没结过婚的作家还无能描写女人，而结了婚的诗人已经无能赞赏女人了。"}]},{"k":["所以"],"r":["ゆえん"],"o":["yuen"],"s":[{"p":["noun (common) (futsuumeishi)"],"e":["reason","grounds"],"z":["原因；理由"]}],"x":[{"j":"我我の自然を愛する所以は、――少くともその所以の一つは自然は我我人間のように妬んだり欺いたりしないからである。","c":"我们之所以爱自然——其原由之一，至少是由于它不像我们人那样既嫉妒又欺骗。"}]},{"k":["由縁"],"r":["ゆえん"],"o":["yuen"],"s":[{"p":["noun (common) (futsuumeishi)"],"e":["acquaintance","relation","affinity","reason"],"z":["关系"]}],"x":[]},{"k":["油煙","油烟"],"r":["ゆえん"],"o":["yuen"],"s":[{"p":["noun (common) (futsuumeishi)"],"e":["lamp soot","lamp smoke","lampblack"],"z":["灯烟"]}],"x":[]},{"k":["故無い","故ない"],"r":["ゆえない"],"o":["yuenai"],"s":[{"p":["adjective (keiyoushi)"],"e":["without a reason"],"z":["无缘由的；没有理由的"]}],"x":[]},{"k":["故なしとしない","故無しとしない"],"r":["ゆえなしとしない"],"o":["yuenashitoshinai"],"s":[{"p":["expressions (phrases, clauses, etc.)","adjective (keiyoushi)"],"e":["reasonable","understandable","justified","not without reason"],"z":["合理的；可以理解的；正当的；并非无故"]}],"x":[]}]