[{"k":["茹でる","煠でる"],"r":["ゆでる","うでる"],"o":["yuderu","uderu"],"s":[{"p":["Ichidan verb","transitive verb"],"e":["to boil (something in hot water)"],"z":["煮沸"]},{"p":["Ichidan verb","transitive verb"],"e":["to treat with medicinal steam (a swelling, etc.)"],"z":["用药蒸治疗"]}],"x":[{"j":"母は卵を十個茹でた。","c":"妈妈煮了十只蛋。"},{"j":"彼女は卵を茹でた。","c":"她煮了蛋。"},{"j":"栗は少なくとも15分は茹でなくてはいけない。","c":"栗子至少要煮15分钟。"}]}]